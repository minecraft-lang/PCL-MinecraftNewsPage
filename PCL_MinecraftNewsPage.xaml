            <local:MyButton Style="{StaticResource WikiLinkBtn}" Text="打开中文 Wiki" ColorType="Highlight"
                EventData="https://zh.minecraft.wiki/" />
            <local:MyButton Style="{StaticResource WikiLinkBtn}" Text="打开英文 Wiki"
                EventData="https://minecraft.wiki/" />
            <local:MyButton Style="{StaticResource WikiLinkBtn}" Text="复制订阅地址"
                EventType="复制文本" EventData="PCL_MinecraftNewsPage.xaml" ToolTip="复制本主页文件名, 便于分享" />
        </WrapPanel>
    </StackPanel>
</local:MyCard>
