<!--
PCL CE Minecraft 新闻主页 v2
数据源: Minecraft Wiki (https://zh.minecraft.wiki / https://minecraft.wiki)
格式: PCL 自定义主页片段 (无根元素, 使用 local: 前缀 PCL 内置控件)
事件: EventType / EventData 绑定 PCL 自定义事件
-->
<StackPanel.Resources>

    <!-- 圆角分组框样式 (仿 PCL 主页卡片) -->
    <Style x:Key="RoundedGroupBoxStyle" TargetType="{x:Type GroupBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Border CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1.5" Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{TemplateBinding BorderBrush}"
                                CornerRadius="10,10,0,0" Padding="12,5,12,5">
                                <ContentPresenter Content="{TemplateBinding Header}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="14" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 新闻标题样式 -->
    <Style TargetType="TextBlock" x:Key="NewsTitle">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 新闻摘要样式 -->
    <Style TargetType="TextBlock" x:Key="NewsSummary">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="#FFC9D1DC" />
    </Style>

    <!-- 日期样式 -->
    <Style TargetType="TextBlock" x:Key="NewsDate">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FF8B949E" />
    </Style>

    <!-- 分类角标样式 -->
    <Style TargetType="Border" x:Key="CategoryBadge">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- 通用链接按钮 (PCL 内置按钮样式) -->
    <Style TargetType="local:MyButton" x:Key="WikiLinkBtn">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="EventType" Value="打开网页" />
    </Style>

    <!-- 分类快捷按钮 -->
    <Style TargetType="local:MyButton" x:Key="CategoryBtn">
        <Setter Property="Margin" Value="4,4,4,4" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="EventType" Value="打开网页" />
    </Style>

</StackPanel.Resources>

<!-- 顶部欢迎卡 -->
<local:MyCard Title="Minecraft 新闻" Margin="0,0,0,20">
    <Grid Margin="0,40,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="20,8,0,0">
            <TextBlock Text="Minecraft 新闻" FontSize="22" FontWeight="Bold"
                Foreground="#FFFFFFFF" />
            <TextBlock Text="数据源: Minecraft Wiki" FontSize="12" Margin="0,4,0,0"
                Foreground="#FFB0B7C3" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,14,0">
            <local:MyButton Text="中文 Wiki" Height="32" Margin="0,0,6,0" Padding="10,0,10,0"
                EventType="打开网页" EventData="https://zh.minecraft.wiki/" />
            <local:MyButton Text="En Wiki" Height="32" Margin="0,0,6,0" Padding="10,0,10,0"
                ColorType="Highlight" EventType="打开网页" EventData="https://minecraft.wiki/" />
            <local:MyIconTextButton Margin="0,0,5,0" Height="32" Text="刷新"
                EventType="刷新主页" ColorType="Highlight" />
        </StackPanel>
    </Grid>
</local:MyCard>

<!-- 分类速览卡 -->
<local:MyCard Title="分类速览" CanSwap="True" Margin="0,20,0,20" IsSwaped="True">
    <StackPanel>
        <TextBlock Text="点击跳转 Minecraft Wiki 对应条目" FontSize="12" Margin="12,40,0,0"
            Foreground="#FFB0B7C3" />
        <WrapPanel Margin="12,4,12,12">
            <local:MyButton Style="{StaticResource CategoryBtn}" Text="版本更新"
                ColorType="Highlight" EventData="https://zh.minecraft.wiki/?search=版本更新" />
            <local:MyButton Style="{StaticResource CategoryBtn}" Text="快照预览"
                EventData="https://zh.minecraft.wiki/?search=快照" />
            <local:MyButton Style="{StaticResource CategoryBtn}" Text="官方公告"
                EventData="https://zh.minecraft.wiki/?search=官方公告" />
            <local:MyButton Style="{StaticResource CategoryBtn}" Text="平台资讯"
                EventData="https://zh.minecraft.wiki/?search=Switch" />
            <local:MyButton Style="{StaticResource CategoryBtn}" Text="Wiki 动态"
                EventData="https://zh.minecraft.wiki/?search=Wiki" />
            <local:MyButton Style="{StaticResource CategoryBtn}" Text="Minecraft Live"
                ColorType="Highlight" EventData="https://zh.minecraft.wiki/?search=Minecraft Live" />
        </WrapPanel>
    </StackPanel>
</local:MyCard>

<!-- 近期新闻卡 -->
