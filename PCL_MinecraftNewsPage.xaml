<!-- 页脚卡 -->
<local:MyCard Title="关于本主页" CanSwap="True" Margin="0,0,0,20" IsSwaped="True">
    <StackPanel Margin="14,40,14,14">
        <TextBlock Style="{StaticResource NewsSummary}"
            Text="新闻内容整理自 Minecraft Wiki (zh.minecraft.wiki / minecraft.wiki), 快照时间 2026-10-31。点击「阅读全文」将跳转 Wiki 搜索对应条目。" />
